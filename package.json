{
  "name": "nl-leren-gent",
  "version": "0.1.0",
  "private": true,
  "description": "Interactieve webapp om Nederlands (Vlaams) te leren, specifiek voor Marokkaans-Darija sprekers die naar Gent verhuizen.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test worker/tests/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply nederlands-leren-gent --local",
    "db:migrate:remote": "wrangler d1 migrations apply nederlands-leren-gent --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.2",
    "wrangler": "^4.0.0"
  }
}
